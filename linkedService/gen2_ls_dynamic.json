{
	"name": "gen2_ls_dynamic",
	"properties": {
		"parameters": {
			"StgAccName": {
				"type": "string"
			},
			"KeyVaultName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "AzureBlobFS",
		"typeProperties": {
			"url": "@{concat('https://',linkedService().StgAccName,'.dfs.core.windows.net/')}",
			"accountKey": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "KeyVault_ls_dynamic",
					"type": "LinkedServiceReference",
					"parameters": {
						"KevVaultName": {
							"value": "@linkedService().KeyVaultName",
							"type": "Expression"
						}
					}
				},
				"secretName": "stgAccAccessKey"
			}
		}
	}
}